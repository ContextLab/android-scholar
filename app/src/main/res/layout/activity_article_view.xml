<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/on_primary"
            app:titleTextColor="@color/on_primary"
            app:title="@string/app_name"
            app:menu="@menu/article_view_menu" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Title -->
            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                tools:text="Attention Is All You Need: A Comprehensive Study of Transformer Architectures" />

            <!-- Authors -->
            <TextView
                android:id="@+id/text_authors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_body"
                tools:text="Ashish Vaswani, Noam Shazeer, Niki Parmar, Jakob Uszkoreit, Llion Jones, Aidan N. Gomez, Lukasz Kaiser, Illia Polosukhin" />

            <!-- Venue/Source and Year -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_venue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body"
                    tools:text="Advances in Neural Information Processing Systems - 2017" />

            </LinearLayout>

            <!-- Citation Count Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_citations"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:checkable="false"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                app:chipBackgroundColor="@color/surface_variant"
                app:chipCornerRadius="@dimen/corner_radius_small"
                app:chipIcon="@drawable/ic_citation"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/text_secondary"
                app:chipMinHeight="32dp"
                app:chipMinTouchTargetSize="0dp"
                app:chipStrokeColor="@color/divider"
                app:chipStrokeWidth="1dp"
                tools:text="Cited by 98,432" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_md"
                android:background="@color/divider" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- PDF Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_pdf"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:text="@string/pdf"
                    android:visibility="gone"
                    app:icon="@drawable/ic_pdf"
                    app:strokeColor="@color/primary"
                    tools:visibility="visible" />

                <!-- Cite Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_cite"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:text="@string/article_cite"
                    app:icon="@drawable/ic_cite"
                    app:strokeColor="@color/primary" />

                <!-- Share Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_share"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:text="@string/menu_share"
                    app:icon="@drawable/ic_share"
                    app:strokeColor="@color/primary" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_md"
                android:background="@color/divider" />

            <!-- Abstract Section -->
            <TextView
                android:id="@+id/label_abstract"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article_abstract"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_subheading" />

            <TextView
                android:id="@+id/text_abstract"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body"
                android:lineSpacingExtra="4dp"
                tools:text="The dominant sequence transduction models are based on complex recurrent or convolutional neural networks that include an encoder and a decoder. The best performing models also connect the encoder and decoder through an attention mechanism. We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely. Experiments on two machine translation tasks show these models to be superior in quality while being more parallelizable and requiring significantly less time to train..." />

            <!-- Divider -->
            <View
                android:id="@+id/divider_cited_by"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_md"
                android:background="@color/divider"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Cited By Section -->
            <LinearLayout
                android:id="@+id/section_cited_by"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/label_cited_by"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/article_cited_by_section"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_subheading" />

                <!-- Cited By Articles Container -->
                <LinearLayout
                    android:id="@+id/container_cited_by"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical" />

                <!-- View All Citations Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_view_all_citations"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/article_view_all_citations"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="end" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:id="@+id/divider_related"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_md"
                android:background="@color/divider"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Related Articles Section -->
            <LinearLayout
                android:id="@+id/section_related"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/label_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/article_related"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_subheading" />

                <!-- Related Articles Container -->
                <LinearLayout
                    android:id="@+id/container_related"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- Bottom padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xl" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.MaterialComponents.CircularProgressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/loading"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/error_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:src="@drawable/ic_error"
            android:contentDescription="@null"
            app:tint="@color/text_hint" />

        <TextView
            android:id="@+id/text_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:text="@string/error_loading"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_retry"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_open_in_browser"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/menu_open_in_browser"
            app:icon="@drawable/ic_open_browser" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
