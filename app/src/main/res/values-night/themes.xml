<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme following Material Design 2 -->
    <style name="Theme.GoogleScholar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">#202124</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">#202124</item>

        <!-- Background and surface colors -->
        <item name="android:colorBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorOnSurface">#FFFFFF</item>

        <!-- Error color -->
        <item name="colorError">@color/error_light</item>
        <item name="colorOnError">#202124</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Text appearances -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.Scholar.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Scholar.Headline2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Scholar.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Scholar.Body2</item>

        <!-- Component styles -->
        <item name="toolbarStyle">@style/Widget.Scholar.Toolbar.Dark</item>
        <item name="navigationViewStyle">@style/Widget.Scholar.NavigationView.Dark</item>
    </style>

    <!-- Dark Text Appearances -->
    <style name="TextAppearance.Scholar.Headline1" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">@dimen/text_size_headline</item>
    </style>

    <style name="TextAppearance.Scholar.Headline2" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">@dimen/text_size_title</item>
    </style>

    <style name="TextAppearance.Scholar.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">#E8EAED</item>
        <item name="android:textSize">@dimen/text_size_subheading</item>
    </style>

    <style name="TextAppearance.Scholar.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">#9AA0A6</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <!-- Dark Toolbar Style -->
    <style name="Widget.Scholar.Toolbar.Dark" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">#1E1E1E</item>
        <item name="titleTextColor">#FFFFFF</item>
        <item name="subtitleTextColor">#E8EAED</item>
        <item name="elevation">@dimen/toolbar_elevation</item>
    </style>

    <!-- Dark Navigation View Style -->
    <style name="Widget.Scholar.NavigationView.Dark" parent="Widget.MaterialComponents.NavigationView">
        <item name="android:background">#1E1E1E</item>
        <item name="itemIconTint">@color/nav_drawer_item_color_dark</item>
        <item name="itemTextColor">@color/nav_drawer_item_color_dark</item>
        <item name="itemBackground">@drawable/nav_item_background_dark</item>
    </style>
</resources>
